{
  "name": "mersal-social-system",
  "version": "2.0.0",
  "private": true,
  "description": "نظام تشغيل الإدارة الاجتماعية — مؤسسة مرسال",
  "scripts": {
    "dev": "next dev -p 3011",
    "build": "prisma generate && next build",
    "start": "next start -p 3011",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node scripts/seed.mjs",
    "db:demo": "node scripts/demo-data.mjs",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts",
    "e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.13",
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dotenv": "^16.4.5",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
